# Same database as Birra Group, Coffee Roastery and Birra Living — every
# site writes to one place so inquiries can be reviewed together. Use the
# Neon POOLED connection string here; migrations need the direct one instead.
DATABASE_URL=

# Contact-form email notifications (shared Resend account across all sites).
RESEND_API_KEY=
CONTACT_NOTIFY_EMAIL=
CONTACT_FROM_EMAIL=

# AI chat (Google Gemini — free tier, no payment required).
GEMINI_API_KEY=

# Cross-links to the sibling sites in the header/footer. Group points at the
# live demo for now; Roastery and Living are still placeholders until real
# domains are registered.
NEXT_PUBLIC_BIRRA_GROUP_URL=https://birra-group.vercel.app/en
NEXT_PUBLIC_BIRRA_ROASTERY_URL=https://birra-roastery.com
NEXT_PUBLIC_BIRRA_LIVING_URL=https://birra-living.com
